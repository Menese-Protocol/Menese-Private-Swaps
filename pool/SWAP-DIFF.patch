+  /// Credit the DAO's seed: the ICP ledger block `block` must be a plain transfer from SNS
+  /// governance's own treasury account to this pool's account, with the seed memo, never credited
+  /// before. ICP pool only. ICP that reaches the account any other way is never reserve.
+  public shared ({ caller }) func swap_reserve_credit(block : Nat64) : async Result<Nat> {
+    if (not isSwapCanister(caller)) return #err("REJECT:not-swap-canister");
+    switch (guardRejection()) { case (?message) return #err(message); case null {} };
+    if (not tokenConfigured()) return #err("REJECT:token-unconfigured");
+    if (not token_history_icp) return #err("REJECT:swap-credit-icp-only");
+    let governance = switch (swapGovernanceAccount()) { case (?a) a; case null return #err("REJECT:not-bound") };
+    if (Map.containsKey(swap_credited_blocks, Nat64.compare, block)) return #err("ALREADY-CREDITED");
+    let found = switch (await fetchIcpBlock(Nat64.toNat(block))) {
+      case (#found(value)) value;
+      case (#absent) return #err("REJECT:swap-credit-block-absent");
+      case (#error(message)) return #err("REJECT:swap-credit-fetch:" # message);
+    };
