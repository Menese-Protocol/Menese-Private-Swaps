+  /// Move the protocol's part of swap fees from the reserve record into this pool's revenue, where
+  /// the pool's protocol-fee settings pay it on. At most once per sweep id.
+  public shared ({ caller }) func swap_fee_sweep(sweepId : Nat64, amount64 : Nat64) : async Result<Nat> {
+    if (not isSwapCanister(caller)) return #err("REJECT:not-swap-canister");
+    let amount = Nat64.toNat(amount64);
+    switch (guardRejection()) { case (?message) return #err(message); case null {} };
+    if (Map.containsKey(swap_sweeps, Nat64.compare, sweepId)) return #err("ALREADY-SWEPT");
+    if (amount == 0) return #err("REJECT:swap-zero-value");
+    if (amount > swap_reserve) return #err("REJECT:swap-reserve-floor");
+    swap_reserve -= amount;
+    protocol_fee_revenue += amount;
+    swap_swept_total += amount;
+    Map.add(swap_sweeps, Nat64.compare, sweepId, amount);
+    #ok(amount)
+  };
