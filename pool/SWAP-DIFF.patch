+    let pool = poolAccount();
+    if (not Blob.equal(to, Principal.toLedgerAccount(pool.owner, pool.subaccount))) return #err("REJECT:swap-credit-receiver");
+    if (found.transaction.memo != SWAP_SEED_MEMO) return #err("REJECT:swap-credit-memo");
+    if (amount == 0) return #err("REJECT:swap-zero-value");
+    let value = Nat64.toNat(amount);
+    swap_reserve += value;
+    swap_credited_total += value;
+    Map.add(swap_credited_blocks, Nat64.compare, block, value);
+    #ok(value)
+  };
