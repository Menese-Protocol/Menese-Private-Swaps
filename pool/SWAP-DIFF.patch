+    if (not isSwapCanister(caller)) return #err("REJECT:not-swap-canister");
+    switch (guardRejection()) { case (?message) return #err(message); case null {} };
+    if (not tokenConfigured()) return #err("REJECT:token-unconfigured");
+    if (not token_history_icp) return #err("REJECT:swap-payout-icp-only");
