+  // ==================== private swaps ====================
+  //
+  // PROPOSAL-private-swaps-v2.md with the rulings of 2026-11-26. The swap canister named in this
+  // module (SwapConfig.SWAP_CANISTER, covered by the module hash the DAO votes on) is the only
+  // caller of every swap_* update method. None of them calls the swap canister back, and none
+  // awaits a token ledger except the payout, which rides the crash-safe prepaid rail above.
+  //
+  // Custody identity at rest:   pool account == pool_value + protocol_fee_revenue + swap_reserve
+  //
+  // swap_reserve rises only by a lock this pool verified itself (swap_lock) or by an SNS-treasury
+  // ICP block this pool read itself (swap_reserve_credit). It falls only by a collect, a fee sweep
+  // into revenue, or a payout to SNS governance's own treasury account, and each of those refuses
+  // when the record is smaller: whatever the swap canister owes, this pool never pays out more
+  // than its providers put in, and the notes of holders who did not take part stay fully backed.
+
+  public type SwapLockArgs = {
+    anchor : Blob;
+    nullifier_1 : Blob;
+    nullifier_2 : Blob;
+    output_1 : OutputRecord;
+    output_2 : OutputRecord;
+    fee : Nat64;
+    v_pub_out : Nat64;
+    proof_hex : Text;
+    /// the swap canister's caller: the one-time principal that will collect the result
+    owner : Principal;
+    /// the swap's terms in the swap canister's own fixed encoding; opaque here, bound by the proof
+    terms : Blob;
+  };
+  public type SwapLock = {
+    lock_id : Nat64;
+    owner : Principal;
+    terms : Blob;
+    amount : Nat64;
+    fee : Nat64;
+    time : Int;
+  };
+  public type SwapCollectArgs = {
+    owed_id : Nat64;
+    amount : Nat64;
+    commitment : Blob;
+    ephemeral_key : Blob;
+    note_ciphertext : Blob;
+    proof_hex : Text;
+  };
+  public type SwapStatus = {
+    enabled : Bool;
+    swap_canister : Principal;
+    reserve : Nat;
+    locked_total : Nat;
+    collected_total : Nat;
+    swept_total : Nat;
+    credited_total : Nat;
+    paid_total : Nat;
+    lock_count : Nat;
+    collect_count : Nat;
+    sweep_count : Nat;
+    payout_pending : Bool;
+    /// unpaid swap_lock / swap_collect verifications that failed in the current window, and
+    /// whether that window's budget is spent (the pool's own bound; see swap_proof_gate)
+    unpaid_proof_failures : Nat;
+    unpaid_proof_budget_spent : Bool;
+  };
+  public type SwapPayoutState = { #done; #pending; #none };
+
+  transient let SWAP_CANISTER : Principal = Principal.fromText(SwapConfig.SWAP_CANISTER);
+  transient let SWAP_TERMS_MAX : Nat = 256;
+  transient let SWAP_PAGE_MAX : Nat = 200;
+  /// The memo of the DAO's seed transfer (proposal 20): the first 8 bytes of
+  /// SHA-256("mpv/private-swaps/hub-seed/v1"), read big-endian.
+  transient let SWAP_SEED_MEMO : Nat64 = 5_423_582_789_349_015_861;
+
+  var swap_enabled : Bool = false;
+  /// The pool's own bound on what an unpaid swap_lock / swap_collect costs it: their failed
+  /// verifications count against this gate's budget (the proof gate's window and budget), not the
+  /// shield/transfer gate's. The swap canister prices these calls first (paid or work); this
+  /// bound holds even if its gate fails. A paid call (verify_price attached) is verified
+  /// unconditionally, as on shield.
+  var swap_proof_gate : ProofGate.Gate = ProofGate.newGate(0);
+  var swap_reserve : Nat = 0;
+  var swap_locked_total : Nat = 0;
+  var swap_collected_total : Nat = 0;
+  var swap_swept_total : Nat = 0;
+  var swap_credited_total : Nat = 0;
+  var swap_paid_total : Nat = 0;
+  /// Every lock, in lock-id order (lock_id == position). The swap canister recovers a lock whose
+  /// reply it never processed by reading this log.
+  let swap_locks = List.empty<SwapLock>();
+  /// owed id -> amount: a collect happens at most once per owed record.
+  let swap_collected = Map.empty<Nat64, Nat>();
+  /// sweep id -> amount: a fee sweep happens at most once per id.
+  let swap_sweeps = Map.empty<Nat64, Nat>();
+  /// ICP block -> amount: a seed block is credited at most once.
+  let swap_credited_blocks = Map.empty<Nat64, Nat>();
+
+  func isSwapCanister(caller : Principal) : Bool { Principal.equal(caller, SWAP_CANISTER) };
+
+  /// The tree a lock or collect computed its transition from is still the pool's tree. Every
+  /// ordinary commit moves `epoch`, which both paths re-check; `repair_tree_state` does not, so
+  /// the tree itself is compared as well, and a transition computed from a tree that is no longer
+  /// current can never be written over it.
+  func swapTreeUnchanged(before : TreeState) : Bool {
+    let now = currentTree();
+    now.root == before.root and now.next_index == before.next_index and Array.equal<Text>(now.filled, before.filled, Text.equal)
+  };
+
+  /// Why a lock or collect must not start (or must not commit after an await) now, or null.
+  /// The same gates a private transfer has, plus the DAO's switch.
+  func swapIntakeRejection() : ?Text {
+    switch (guardRejection()) { case (?message) return ?message; case null {} };
+    if (not configured()) return ?"REJECT:unconfigured";
+    if (not tokenConfigured()) return ?"REJECT:token-unconfigured";
+    if (state_quarantine) return ?"REJECT:state-quarantined";
+    if (not tree_frontier_enabled) return ?"REJECT:frontier-disabled";
+    if (not swap_enabled) return ?"REJECT:swaps-disabled";
+    // the tree-order rule of private transfers: no tree mutation while a token intent is pending
+    if (pending_shield != null or pending_unshield != null) return ?"REJECT:pending-token-mutation";
+    null
+  };
+
+  /// The `recipient_binding` a lock proves: ICRC-3 hash of the domain, this pool, its token, the
+  /// swap canister, the owner and the terms, high byte cleared (the reduction of
+  /// recipientBindingValue). A lock proof can therefore not be replayed into another pool, another
+  /// token, another swap canister, another owner or other terms, nor used as a transfer or an
+  /// unshield (different domains).
+  func swapLockBindingValue(owner : Principal, terms : Blob) : Result<Blob> {
+    let token = switch (token_ledger_id) {
+      case (?value) value;
+      case null return #err("REJECT:token-unconfigured");
+    };
+    let entries = List.empty<(Text, ICRC3.Value)>();
+    List.add(entries, ("domain", #Text("picp-swap-lock/v1")));
+    List.add(entries, ("pool", #Blob(Principal.toBlob(selfPrincipal()))));
+    List.add(entries, ("token", #Blob(Principal.toBlob(token))));
+    List.add(entries, ("swap", #Blob(Principal.toBlob(SWAP_CANISTER))));
+    List.add(entries, ("owner", #Blob(Principal.toBlob(owner))));
+    List.add(entries, ("terms", #Blob(terms)));
+    let digest = Blob.toArray(ICRC3.hashValue(#Map(List.toArray(entries))));
+    if (digest.size() != 32) return #err("REJECT:swap-binding-hash");
+    #ok(Blob.fromArray(Array.tabulate<Nat8>(32, func(i) { if (i == 31) 0 else digest[i] })))
+  };
+
+  /// Lock: verify a transfer proof whose public value leaves the notes for the swap reserve, burn
+  /// its two input notes, append its two change notes, move its flat fee into revenue and raise
+  /// the reserve record, all in one commit. No token moves.
+  public shared ({ caller }) func swap_lock(args : SwapLockArgs) : async Result<SwapLock> {
+    if (not isSwapCanister(caller)) return #err("REJECT:not-swap-canister");
+    switch (swapIntakeRejection()) { case (?e) return #err(e); case null {} };
+    if (transfer_statement_version != 2) return #err("REJECT:transfer-statement-version");
+    if (args.terms.size() == 0 or args.terms.size() > SWAP_TERMS_MAX) return #err("REJECT:swap-terms-size");
+    if (args.v_pub_out == 0) return #err("REJECT:swap-zero-value");
+    if (Principal.isAnonymous(args.owner)) return #err("REJECT:swap-anonymous-owner");
+    if (not fieldSized(args.anchor) or not fieldSized(args.nullifier_1) or not fieldSized(args.nullifier_2)) {
+      return #err("REJECT:field-length");
+    };
+    switch (validateOutput(args.output_1)) { case (?e) return #err(e); case null {} };
+    switch (validateOutput(args.output_2)) { case (?e) return #err(e); case null {} };
+    switch (shapeRejection(args.output_1.ephemeral_key, args.output_1.note_ciphertext)) { case (?e) return #err(e); case null {} };
+    switch (shapeRejection(args.output_2.ephemeral_key, args.output_2.note_ciphertext)) { case (?e) return #err(e); case null {} };
+    let binding = switch (swapLockBindingValue(args.owner, args.terms)) {
+      case (#ok(value)) value;
+      case (#err(message)) return #err(message);
+    };
+    if (not StableBlobSet.contains(historical_roots, args.anchor)) return #err("REJECT:unknown-anchor");
+    // the nullifier guards of confidential_transfer (audit F1a/F2), in the same order
+    if (PoseidonTree.blobToNat(args.nullifier_1) == null or PoseidonTree.blobToNat(args.nullifier_2) == null) {
+      return #err("REJECT:nullifier-noncanonical");
+    };
+    if (args.nullifier_1 == args.nullifier_2) return #err("REJECT:duplicate-nullifier-in-tx");
+    if (StableBlobSet.contains(spent_nullifiers, args.nullifier_1) or
+        StableBlobSet.contains(spent_nullifiers, args.nullifier_2)) {
+      return #err("REJECT:nullifier-spent");
+    };
+    let value = Nat64.toNat(args.v_pub_out);
+    let fee = Nat64.toNat(args.fee);
+    if (value + fee > pool_value) return #err("REJECT:turnstile");
+    let inputs = switch (serializePublicInputs([
+      args.anchor,
+      args.nullifier_1,
+      args.nullifier_2,
+      args.output_1.commitment,
+      args.output_2.commitment,
+      nat64Field(args.fee),
+      nat64Field(args.v_pub_out),
+      binding,
+    ])) {
+      case (?encoded) encoded;
+      case null return #err("REJECT:public-input-encoding");
+    };
+    let startEpoch = epoch;
+    let paid = takePaid<system>();
+    if (not paid) {
+      switch (swapUnpaidGate()) { case (?e) return #err(e); case null {} };
+    };
+    let verdict = verifyTransferProof(args.proof_hex, inputs);
+    if (verdict != "ACCEPT") {
+      recordFailedVerification(verdict, if (paid) null else ?swap_proof_gate);
+      return #err(verdict);
+    };
+    let treeBefore = currentTree();
+    let leaves = [blobToHex(args.output_1.commitment), blobToHex(args.output_2.commitment)];
+    for (leaf in leaves.vals()) {
+      switch (PoseidonTree.parseFieldElement(leaf)) { case (?_) {}; case null return #err("REJECT:commitment-noncanonical") };
+    };
+    let localNext = switch (frontierLocalNext(treeBefore, leaves)) {
+      case (#ok(value)) value;
+      case (#err(message)) return #err(message);
+    };
+    let transition = switch (localNext) {
+      case (?local) {
+        if (tree_oracle_id == null) { { state = ?local; error = null } : TreeTransition } else {
+          try { await treeActor().append(treeBefore, leaves) } catch (error) {
+            return #err("REJECT:tree-oracle-call:" # Error.message(error));
+          }
+        }
+      };
+      case null {
+        try { await treeActor().append(treeBefore, leaves) } catch (error) {
+          return #err("REJECT:tree-oracle-call:" # Error.message(error));
+        }
+      };
+    };
+    // Every check made before the await, made again: nothing was written before it.
+    switch (swapIntakeRejection()) { case (?e) return #err(e); case null {} };
+    if (epoch != startEpoch) return #err("REJECT:state-changed");
+    if (not swapTreeUnchanged(treeBefore)) return #err("REJECT:state-changed");
+    if (not StableBlobSet.contains(historical_roots, args.anchor)) return #err("REJECT:unknown-anchor");
+    if (StableBlobSet.contains(spent_nullifiers, args.nullifier_1) or
+        StableBlobSet.contains(spent_nullifiers, args.nullifier_2)) {
+      return #err("REJECT:nullifier-spent");
+    };
+    if (value + fee > pool_value) return #err("REJECT:turnstile");
+    let next = switch (parseTransition(transition)) {
+      case (#ok(state)) state;
+      case (#err(message)) return #err(message);
+    };
+    switch (frontierCrossCheck(localNext, next, "swap-lock")) { case (?message) return #err(message); case null {} };
+    let rootAfter = switch (hexToBlob(next.root)) {
+      case (?root) root;
+      case null return #err("REJECT:tree-root-hex");
+    };
+    // No await after this point: the lock commits whole or not at all.
+    pool_value -= value + fee;
+    protocol_fee_revenue += fee;
+    swap_reserve += value;
+    swap_locked_total += value;
+    addNullifier(args.nullifier_1);
+    addNullifier(args.nullifier_2);
+    tree_state := ?next;
+    note_root := rootAfter;
+    addRoot(rootAfter);
+    let nullifiers = [args.nullifier_1, args.nullifier_2];
+    appendBlock(args.output_1, nullifiers, args.anchor, rootAfter, #confidential_transfer);
+    appendBlock(args.output_2, nullifiers, args.anchor, rootAfter, #confidential_transfer);
+    let lock : SwapLock = {
+      lock_id = Nat64.fromNat(List.size(swap_locks));
+      owner = args.owner;
+      terms = args.terms;
+      amount = args.v_pub_out;
+      fee = args.fee;
+      time = Time.now();
+    };
+    List.add(swap_locks, lock);
+    epoch += 1;
+    refreshCertification();
+    #ok(lock)
+  };
+
+  /// Collect: verify a deposit proof for exactly the owed amount, append the note, and lower the
+  /// reserve record, refusing below it. At most once per owed id: a second collect of the same id
+  /// answers ALREADY-COLLECTED, which is how the swap canister learns of a collect whose reply it
+  /// lost.
+  public shared ({ caller }) func swap_collect(args : SwapCollectArgs) : async Result<Nat> {
+    if (not isSwapCanister(caller)) return #err("REJECT:not-swap-canister");
+    switch (guardRejection()) { case (?message) return #err(message); case null {} };
+    if (Map.containsKey(swap_collected, Nat64.compare, args.owed_id)) return #err("ALREADY-COLLECTED");
+    switch (swapIntakeRejection()) { case (?e) return #err(e); case null {} };
+    let amount = Nat64.toNat(args.amount);
+    if (amount == 0) return #err("REJECT:swap-zero-value");
+    if (amount > swap_reserve) return #err("REJECT:swap-reserve-floor");
+    let output : OutputRecord = {
+      commitment = args.commitment;
+      ephemeral_key = args.ephemeral_key;
+      note_ciphertext = args.note_ciphertext;
+    };
+    switch (validateOutput(output)) { case (?e) return #err(e); case null {} };
+    switch (shapeRejection(output.ephemeral_key, output.note_ciphertext)) { case (?e) return #err(e); case null {} };
+    // the shield seam (audit F3): the value enters the statement only through nat64Field
+    let inputs = switch (serializePublicInputs([args.commitment, nat64Field(args.amount)])) {
+      case (?encoded) encoded;
+      case null return #err("REJECT:public-input-encoding");
+    };
+    let startEpoch = epoch;
+    let paid = takePaid<system>();
+    if (not paid) {
+      switch (swapUnpaidGate()) { case (?e) return #err(e); case null {} };
+    };
+    let verdict = verifyShieldProof(args.proof_hex, inputs);
+    if (verdict != "ACCEPT") {
+      recordFailedVerification(verdict, if (paid) null else ?swap_proof_gate);
+      return #err(verdict);
+    };
+    let treeBefore = currentTree();
+    let leaves = [blobToHex(args.commitment)];
+    switch (PoseidonTree.parseFieldElement(leaves[0])) { case (?_) {}; case null return #err("REJECT:commitment-noncanonical") };
+    let localNext = switch (frontierLocalNext(treeBefore, leaves)) {
+      case (#ok(value)) value;
+      case (#err(message)) return #err(message);
+    };
+    let transition = switch (localNext) {
+      case (?local) {
+        if (tree_oracle_id == null) { { state = ?local; error = null } : TreeTransition } else {
+          try { await treeActor().append(treeBefore, leaves) } catch (error) {
+            return #err("REJECT:tree-oracle-call:" # Error.message(error));
+          }
+        }
+      };
+      case null {
+        try { await treeActor().append(treeBefore, leaves) } catch (error) {
+          return #err("REJECT:tree-oracle-call:" # Error.message(error));
+        }
+      };
+    };
+    // Every check made before the await, made again: a concurrent collect of the same id, or one
+    // that drew the reserve down, must not both pass.
+    if (Map.containsKey(swap_collected, Nat64.compare, args.owed_id)) return #err("ALREADY-COLLECTED");
+    switch (swapIntakeRejection()) { case (?e) return #err(e); case null {} };
+    if (epoch != startEpoch) return #err("REJECT:state-changed");
+    if (not swapTreeUnchanged(treeBefore)) return #err("REJECT:state-changed");
+    if (amount > swap_reserve) return #err("REJECT:swap-reserve-floor");
+    let next = switch (parseTransition(transition)) {
+      case (#ok(state)) state;
+      case (#err(message)) return #err(message);
+    };
+    switch (frontierCrossCheck(localNext, next, "swap-collect")) { case (?message) return #err(message); case null {} };
+    let rootAfter = switch (hexToBlob(next.root)) {
+      case (?root) root;
+      case null return #err("REJECT:tree-root-hex");
+    };
+    let anchorBefore = note_root;
+    swap_reserve -= amount;
+    pool_value += amount;
+    swap_collected_total += amount;
+    Map.add(swap_collected, Nat64.compare, args.owed_id, amount);
+    tree_state := ?next;
