+      #is_known_root : Any; #icrc3_supported_block_types : Any; #icrc3_get_archives : Any;
+      #icrc3_get_blocks : Any; #detection_stream : Any; #detect_chain_enable : Any;
+      #detect_chain_disable : Any; #detect_stream_anchor : Any; #detect_boundary_proof : Any;
+      #shield : () -> DepositArgs; #resume_shield : Any; #resume_unshield : Any; #prepaid_fee_status : Any;
